# This is a bridge regression check, not a comparison against rANS.
foreach(required LEGACY_EXE RUST_EXE WORK_DIR REPORT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(WRITE "${REPORT}" "backend,block_threshold,run,encode_seconds,decode_seconds\n")
foreach(block 1 20000)
    foreach(run RANGE 1 5)
        foreach(backend legacy rust)
            file(MAKE_DIRECTORY "${WORK_DIR}/bench-${backend}")
            if(backend STREQUAL "legacy")
                set(program "${LEGACY_EXE}")
            else()
                set(program "${RUST_EXE}")
            endif()
            execute_process(COMMAND taskset -c 2 "${program}" -b ../input.csv ../input.config 0 1 ${block}
                WORKING_DIRECTORY "${WORK_DIR}/bench-${backend}" RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
            if(NOT status EQUAL 0)
                message(FATAL_ERROR "Benchmark failed: ${status}: ${errors}")
            endif()
            file(WRITE "${WORK_DIR}/bench-${backend}/${block}-${run}.log" "${log}")
            string(REGEX MATCHALL "Time:  [0-9.]+ s" times "${log}")
            list(GET times 0 encode)
            list(GET times 1 decode)
            string(REGEX REPLACE "Time:  ([0-9.]+) s" "\\1" encode "${encode}")
            string(REGEX REPLACE "Time:  ([0-9.]+) s" "\\1" decode "${decode}")
            file(APPEND "${REPORT}" "${backend},${block},${run},${encode},${decode}\n")
        endforeach()
    endforeach()
endforeach()
